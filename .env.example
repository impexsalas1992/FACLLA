# GEMINI_API_KEY: Clave de API de Google Gemini para procesamiento de comprobantes e informes financieros
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL pública donde está alojada la aplicación
APP_URL="MY_APP_URL"

# PORT: Puerto del servidor (por defecto 3000 o el asignado por el hosting como Render/Railway/Cloud Run)
PORT=3000
